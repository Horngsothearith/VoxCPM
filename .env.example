# VoxCPM API Server Configuration
# ===============================

# Host port mapping
PORT=8000

# Model ID:
# - openbmb/VoxCPM2 (Recommended, 2B, 30 languages, Voice Design, 48kHz)
# - openbmb/VoxCPM-0.5B (Lighter, faster on CPU / low RAM)
# - openbmb/VoxCPM1.5 (High-fidelity continuation cloning)
# - Or a path to a local directory inside the container
VOXCPM_MODEL_ID=openbmb/VoxCPM2

# Execution device: auto, cpu, cuda, cuda:0
VOXCPM_DEVICE=auto

# Load acoustic ZipEnhancer denoiser (true/false) - default false to save RAM
VOXCPM_LOAD_DENOISER=false

# Enable torch.compile optimization (true/false) - recommended true on Linux with CUDA
VOXCPM_OPTIMIZE=false

# ---- Accounts, API keys & credits ----
# Require an API key (or a logged-in session) for generation; false = open, free local server
VOXCPM_AUTH=true
# Credits given to every new account (1 credit = 1 input character)
VOXCPM_SIGNUP_CREDITS=2000
# Comma-separated emails that get the admin "Users" page in the dashboard
VOXCPM_ADMIN_EMAILS=
# Payments: "demo" grants purchased credit packs instantly (testing only!); "off" disables purchases
VOXCPM_PAYMENTS=off
# SQLite database for users/keys/credits (inside the container: /app/data/accounts.db)
# VOXCPM_DB_PATH=data/accounts.db
